# ===== 阶段一配置模板：复制为 .env 后填真实值 =====
# cp .env.example .env && chmod 600 .env && nano .env

# ---- LLM 供应商 ----
# cloud = 阿里百炼云端；local = 阶段三的 llama.cpp 本地模型
LLM_PROVIDER=cloud

# ---- 阿里云百炼（DashScope）----
# 一个 key 同时用于 chat 和 embedding
# 申请：https://bailian.console.aliyun.com/  → API-KEY 管理
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# chat 模型：qwen-plus 质量与成本平衡；想省钱可换 qwen-turbo
LLM_MODEL=qwen-plus

# embedding 模型与维度（text-embedding-v4 支持 2048/1536/1024/768/512/256/128/64）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# ★ 百炼 embedding 单次最多 10 行输入，不要改大
EMBEDDING_BATCH_SIZE=10
# embedding 调用超时（秒）与重试次数
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2

# ---- 阶段三才会用到，现在留空 ----
LOCAL_LLM_BASE_URL=http://llama:8080/v1
LOCAL_LLM_MODEL=qwen2.5-1.5b-instruct

# ---- 向量库：独立 Chroma 服务（compose 中的 chroma 容器）----
# 容器间通过服务名互访；这两个值一般不用改。
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
COLLECTION_NAME=phase1_docs

# ---- 会话热缓存：Redis ----
# 指向 compose 里的 redis 容器（容器内网名 redis，容器内端口 6379）。
# 留空则热缓存关闭，读历史会直接落到 PostgreSQL（功能正常，只是慢一点）。
REDIS_URL=redis://redis:6379/0
# 热缓存 TTL：7 天。注意这只影响缓存，不影响 PostgreSQL 里的永久存档。
MEMORY_TTL_SECONDS=604800

# ---- 会话存档：PostgreSQL（真相源）----
# 这三个变量同时被 compose 用来初始化 postgres 容器，务必保持一致。
POSTGRES_DB=ragdb
POSTGRES_USER=rag
# ★ 必须改成自己的强口令；compose 会在未设置时直接报错，不会用默认值启动
POSTGRES_PASSWORD=
# 连接串：容器内网主机名 postgres、端口 5432
POSTGRES_DSN=postgresql://rag:CHANGE_ME@postgres:5432/ragdb
PG_POOL_MIN=1
PG_POOL_MAX=4

# ---- 检索参数 ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4

# ---- 入库护栏（2026-10-07 按服务器规格新增）----
# 真正决定 embedding 成本与容器负载的是「切片数」，不是「文件体积」。
# 起因：一次测试里 22MB 纯文本被切成 33002 个片段疯狂调 embedding，打挂了容器。
# 取值依据见 backend/app/config.py 的注释（2 vCPU / 8 GiB，百炼单次 10 行）。
INGEST_MAX_CHARS=2000000
INGEST_MAX_CHUNKS=1200
INGEST_MAX_CONCURRENT=1

# ---- HTTP 层护栏 ----
# 跨域白名单：逗号分隔的完整源，留空 = 只允许同源。
# 前端 /ui 与 API 同源，留空不影响正常使用；
# 将来挂域名（如 Nginx 反代）后，在这里补上该域名即可。
CORS_ORIGINS=
# 单文件上传上限（MB）—— 这只是第一道粗筛，真正的闸门是上面的 INGEST_MAX_CHUNKS
MAX_UPLOAD_MB=50

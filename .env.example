# ===== 阶段一配置模板：复制为 .env 后填真实值 =====
# cp .env.example .env && chmod 600 .env && nano .env

# ---- LLM 供应商 ----
# cloud = 阿里百炼云端；local = 阶段三的 llama.cpp 本地模型
LLM_PROVIDER=cloud

# ---- 阿里云百炼（DashScope）----
# 一个 key 同时用于 chat 和 embedding
# 申请：https://bailian.console.aliyun.com/  → API-KEY 管理
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# chat 模型：qwen-plus 质量与成本平衡；想省钱可换 qwen-turbo
LLM_MODEL=qwen-plus

# embedding 模型与维度（text-embedding-v4 支持 2048/1536/1024/768/512/256/128/64）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# ★ 百炼 embedding 单次最多 10 行输入，不要改大
EMBEDDING_BATCH_SIZE=10

# ---- 阶段三才会用到，现在留空 ----
LOCAL_LLM_BASE_URL=http://llama:8080/v1
LOCAL_LLM_MODEL=qwen2.5-1.5b-instruct

# ---- Upstash Redis（对话记忆）----
# 未填则自动降级为进程内记忆，服务照常可用
# 注意必须是 rediss:// 开头（带 TLS）
REDIS_URL=

# ---- 检索参数 ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4

COLLECTION_NAME=phase1_docs

# ---- HTTP 层护栏（2026-10-07 新增，服务器完善）----
# 跨域白名单：逗号分隔的完整源，留空 = 只允许同源。
# 前端 /ui 与 API 同源，留空不影响正常使用；
# 将来挂域名（如 Nginx 反代）后，在这里补上该域名即可。
CORS_ORIGINS=
# 单文件上传上限（MB）
MAX_UPLOAD_MB=50

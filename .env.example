# ===== 阶段一配置模板：复制为 .env 后填真实值 =====
# cp .env.example .env && chmod 600 .env && nano .env

# ---- LLM 供应商 ----
# cloud = 任意 OpenAI 兼容云端端点；local = 阶段三的 llama.cpp 本地模型
LLM_PROVIDER=cloud

# ============================ 供应商凭证（2026-10-15 解耦）============================
# ★ chat 与 embedding 现在各配各的，可以指向同一家，也可以指向两家。
#
# 回退链（新变量优先，旧的 DASHSCOPE_* 仍兼容但仅作回退）：
#   LLM_API_KEY        ← LLM_API_KEY        ‖ DASHSCOPE_API_KEY
#   LLM_BASE_URL       ← LLM_BASE_URL       ‖ DASHSCOPE_BASE_URL
#   EMBEDDING_API_KEY  ← EMBEDDING_API_KEY  ‖ LLM_API_KEY
#   EMBEDDING_BASE_URL ← EMBEDDING_BASE_URL ‖ LLM_BASE_URL
# 也就是说：只配一家供应商时，EMBEDDING_* 留空即可，会自动沿用 chat 那套。
#
# ★★ 三条硬约束，配错会以「对话/入库时报错」的形式出现，离配置很远：
#   1) base_url 必须带供应商的完整路径前缀，各家不同 ——
#      百炼 https://dashscope.aliyuncs.com/compatible-mode/v1
#      智谱 https://open.bigmodel.cn/api/paas/v4      ← 注意不是 /v1
#   2) 模型的归属：LLM_MODEL 要填【该 base_url 那家】的模型名，混填必 404/400。
#   3) 没有 embedding 接口的供应商（如 DeepSeek）不能只填一家 ——
#      必须另外给出 EMBEDDING_API_KEY / EMBEDDING_BASE_URL，否则整条 RAG 链路不可用。
#
# ---- 示例 A：智谱 GLM（一家覆盖两条链路，含免费档）----
# Key 格式是两段式 {id}.{secret}，中间的点号必须一起复制，少一段就报 401。
# 控制台：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=embedding-3
# 智谱 embedding-3 单次上限 64 行（百炼 text-embedding-v4 只有 10）。见下方说明。
EMBEDDING_BATCH_SIZE=64

# ---- 示例 B：阿里云百炼（旧配置写法，仍然可用）----
# DASHSCOPE_API_KEY=sk-xxxxxxxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_BATCH_SIZE=10

# embedding 输出维度。text-embedding-v4 与 embedding-3 都支持 1024，但
# ★ 不同模型的向量空间不通用：换模型后即便维度一样也必须重新入库，
#   否则检索「有结果但全错」，比报错更难发现。
EMBEDDING_DIM=1024
# embedding 单次请求的最大行数。这是【供应商能力】，默认 10 对所有已知供应商安全。
# 调大前先确认你在用的那家的上限（百炼 10 / 智谱 64），设大了直接 400。
# embedding 调用超时（秒）与重试次数
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2

# ---- 阶段三才会用到，现在留空 ----
LOCAL_LLM_BASE_URL=http://llama:8080/v1
LOCAL_LLM_MODEL=qwen2.5-1.5b-instruct

# ---- 向量库：独立 Chroma 服务（compose 中的 chroma 容器）----
# 容器间通过服务名互访；这两个值一般不用改。
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
COLLECTION_NAME=phase1_docs

# ---- 会话热缓存：Redis ----
# 指向 compose 里的 redis 容器（容器内网名 redis，容器内端口 6379）。
# 留空则热缓存关闭，读历史会直接落到 PostgreSQL（功能正常，只是慢一点）。
REDIS_URL=redis://redis:6379/0
# 热缓存 TTL：7 天。注意这只影响缓存，不影响 PostgreSQL 里的永久存档。
MEMORY_TTL_SECONDS=604800

# ---- 会话存档：PostgreSQL（真相源）----
# 这三个变量同时被 compose 用来初始化 postgres 容器，务必保持一致。
POSTGRES_DB=ragdb
POSTGRES_USER=rag
# ★ 必须改成自己的强口令；compose 会在未设置时直接报错，不会用默认值启动
POSTGRES_PASSWORD=
# 连接串：容器内网主机名 postgres、端口 5432
POSTGRES_DSN=postgresql://rag:CHANGE_ME@postgres:5432/ragdb
PG_POOL_MIN=1
PG_POOL_MAX=4

# ---- 个人凭证库 ----
# 生成一次并妥善保管；丢失后已存凭证无法解密。切勿提交到 Git 或发到聊天。
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=
# HTTPS 部署必须为 true；仅本机 HTTP + SSH 隧道开发时可为 false。
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=43200

# ---- 认证模式（2026-10-14 新增）----
# session = 需要账号密码登录，多用户互相隔离（代码里的默认值）
# local   = 单用户本地模式：界面不显示登录，所有请求自动归属到
#           LOCAL_OWNER_USERNAME 这一个身份。适合「自己电脑上的个人助手」。
#
# ★ 取舍：local 模式下服务不再有任何鉴权。它只对「仅本机访问 + 单人使用」
#   成立。若将来要把服务暴露到公网/局域网给多人用，必须切回 session。
#   端口仍只绑 127.0.0.1 是本条成立的前提（见 docker-compose.yml 的 ports）。
AUTH_MODE=local
# password = 单用户 + 访问口令：部署在自己的服务器、用地址远程打开网页时使用。
#   需同时设置 ACCESS_PASSWORD（12 位以上）和 AUTH_COOKIE_SECURE=true（走 HTTPS）。
#   改口令后重启 api，旧登录会话自动失效。

# 本地模式使用的身份（用户名）。该用户不存在时自动创建（随机口令，不使用口令登录）。
# ★ 本机已存在数据时，必须与既有用户名一致 —— 否则凭证库、会话会显示为空。
#   数据一条都没丢，只是 owner 变了；而 owner 隔离是设计如此，不是 bug。
#   本机现状：知识库文档属于 shared（人人可见）；会话与东软凭证属于 admin。
LOCAL_OWNER_USERNAME=admin
ACCESS_PASSWORD=
# HTTPS 入口（可选）：域名已解析到本机后，docker compose --profile https up -d caddy
PUBLIC_DOMAIN=

# ---- 检索参数 ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATE_K=12
# 以当前评测集初步校准；提高会更保守，降低可能把弱相关片段送给模型。
RETRIEVAL_MIN_RELEVANCE=0.42
RETRIEVAL_MIN_LEXICAL_COVERAGE=0.30
# 超过上限时禁用 BM25 全量索引并明确记录日志，向量检索仍可用。
RETRIEVAL_MAX_LEXICAL_CHUNKS=10000

# ---- 入库护栏（2026-10-07 按服务器规格新增）----
# 真正决定 embedding 成本与容器负载的是「切片数」，不是「文件体积」。
# 起因：一次测试里 22MB 纯文本被切成 33002 个片段疯狂调 embedding，打挂了容器。
# 取值依据见 backend/app/config.py 的注释（2 vCPU / 8 GiB，百炼单次 10 行）。
INGEST_MAX_CHARS=2000000
INGEST_MAX_CHUNKS=1200
INGEST_MAX_CONCURRENT=1

# ---- HTTP 层护栏 ----
# 跨域白名单：逗号分隔的完整源，留空 = 只允许同源。
# 前端 /ui 与 API 同源，留空不影响正常使用；
# 将来挂域名（如 Nginx 反代）后，在这里补上该域名即可。
CORS_ORIGINS=
# 单文件上传上限（MB）—— 这只是第一道粗筛，真正的闸门是上面的 INGEST_MAX_CHUNKS
MAX_UPLOAD_MB=50
# Optional extensions. Only entries with "enabled": true are loaded.
# HTTP MCP must use HTTPS; stdio commands run inside the API container.
MCP_SERVERS_JSON={}

# 可选网页搜索 profile：先替换为随机值，再启动 --profile web-search。
# 生成：python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SEARXNG_SECRET=replace-with-a-random-secret-before-enabling-web-search
SKILLS_DIR=/app/skills

# 启用的内置插件（逗号分隔，对应 backend/app/plugins/<name>/plugin.json）。
# 默认 campus；留空即为不含任何校园站点的通用个人助手。
ENABLED_PLUGINS=campus

# 助手人设（可选）。ASSISTANT_DOMAIN 写进知识库回答的提示词（如「校园」「公司」「产品」），
# 两个栏目名显示在聊天顶部。默认是个人知识库；做校园等场景可自行改。
ASSISTANT_DOMAIN=个人
KNOWLEDGE_TAB_LABEL=个人RAG
ASSISTANT_TAB_LABEL=个人助手
